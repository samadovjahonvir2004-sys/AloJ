+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.R;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BottomSheet;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.ChatActivityEnterView;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/** AloJ: tools inside a chat (header menu → uz.aloj.L.t("AloJ vositalari", "Инструменты AloJ")). */
+public final class AloJChatSheet {
+    public static final int MENU_ID = 7777;
+    private static final int REQ_SPEECH = 7401;
+
+    private static final String[] LANG_CODES = {"uz", "ru", "en", "tr", "zh", "ar", "ko", "de", "kk", "tg", "ky"};
+    private static final String[] LANG_NAMES = {uz.aloj.L.t("O'zbekcha", "Узбекский"), uz.aloj.L.t("Ruscha", "Русский"), uz.aloj.L.t("Inglizcha", "Английский"), uz.aloj.L.t("Turkcha", "Турецкий"), uz.aloj.L.t("Xitoycha", "Китайский"), uz.aloj.L.t("Arabcha", "Арабский"), uz.aloj.L.t("Koreyscha", "Корейский"), uz.aloj.L.t("Nemischa", "Немецкий"), uz.aloj.L.t("Qozoqcha", "Казахский"), uz.aloj.L.t("Tojikcha", "Таджикский"), uz.aloj.L.t("Qirg'izcha", "Киргизский")};
+    private static final String[] SPEECH_LANGS = {"uz-UZ", "ru-RU", "en-US", "tr-TR"};
+
+    private static final HashSet<Long> scanned = new HashSet<>();
+
+    private AloJChatSheet() {}
+
+    private static void toast(ChatActivity f, String s) {
+        if (f.getParentActivity() != null) Toast.makeText(f.getParentActivity(), s, Toast.LENGTH_LONG).show();
+    }
+
+    private static CharSequence field(ChatActivity f) {
+        ChatActivityEnterView v = f.getChatActivityEnterView();
+        return v == null ? null : v.getFieldText();
+    }
+
+    private static void setField(ChatActivity f, CharSequence text) {
+        ChatActivityEnterView v = f.getChatActivityEnterView();
+        if (v != null) v.setFieldText(text);
+    }
+
+    public static void show(ChatActivity f) {
+        Activity a = f.getParentActivity();
+        if (a == null) return;
+        final boolean ghost = AloJConfig.hideTyping() && AloJConfig.hideOnline();
+        final String mode = translateMode(f.getDialogId());
+        CharSequence[] items = {
+                mode == null ? uz.aloj.L.t("Tarjima rejimi: o'chiq (yoqish)", "Режим перевода: выкл (включить)") : uz.aloj.L.t("Tarjima rejimi: ", "Режим перевода: ") + langName(mode) + uz.aloj.L.t(" (o'chirish)", " (выключить)"),
+                uz.aloj.L.t("Tarjima qilib yuborish (yozgan matnim)", "Перевести мой текст перед отправкой"),
+                uz.aloj.L.t("Ovoz bilan yozish", "Голосовой ввод"),
+                uz.aloj.L.t("Lotin ↔ Kirill (yozgan matnim)", "Латиница ↔ кириллица (мой текст)"),
+                uz.aloj.L.t("Valyuta kalkulyatori", "Калькулятор валют"),
+                ghost ? uz.aloj.L.t("Arvoh rejimi: YONIQ (o'chirish)", "Режим «призрак»: ВКЛ (выключить)") : uz.aloj.L.t("Arvoh rejimi: o'chiq (yoqish)", "Режим «призрак»: выкл (включить)"),
+                uz.aloj.L.t("Chatni firibgarlikka tekshirish", "Проверить чат на мошенничество"),
+                uz.aloj.L.t("Masofaviy yordam (ekranni ko'rsatish)", "Удалённая помощь (показ экрана)"),
+                uz.aloj.L.t("Barcha AloJ sozlamalari", "Все настройки AloJ")
+        };
+        int[] icons = {R.drawable.msg_translate, R.drawable.msg_translate, R.drawable.input_mic, R.drawable.msg_text_outlined, R.drawable.msg_payment_card,
+                R.drawable.msg_secret, R.drawable.msg_report, R.drawable.msg_videocall, R.drawable.msg_settings_old};
+        BottomSheet.Builder b = new BottomSheet.Builder(a, false, f.getResourceProvider());
+        b.setTitle(uz.aloj.L.t("AloJ vositalari", "Инструменты AloJ"), true);
+        b.setItems(items, icons, (d, which) -> {
+            switch (which) {
+                case 0:
+                    if (mode != null) {
+                        setTranslateMode(f.getDialogId(), null);
+                        toast(f, uz.aloj.L.t("Tarjima rejimi o'chirildi", "Режим перевода выключен"));
+                    } else {
+                        pickTranslateMode(f);
+                    }
+                    break;
+                case 1: translateOutgoing(f); break;
+                case 2: pickSpeechLang(f); break;
+                case 3: translitOutgoing(f); break;
+                case 4: currency(f); break;
+                case 5:
+                    AloJConfig.set("hideTyping", !ghost);
+                    AloJConfig.set("hideOnline", !ghost);
+                    toast(f, !ghost ? uz.aloj.L.t("👻 Arvoh rejimi yoqildi: \"yozmoqda\" va onlayn holatingiz ko'rinmaydi", "👻 Режим «призрак» включён: «печатает» и «в сети» скрыты") : uz.aloj.L.t("Arvoh rejimi o'chirildi", "Режим «призрак» выключен"));
+                    break;
+                case 6: scan(f, true); break;
+                case 7: remoteHelp(f); break;
+                case 8: f.presentFragment(new org.telegram.ui.AloJHubActivity(null)); break;
+            }
+        });
+        f.showDialog(b.create());
+    }
+
+    // ---------------- "✨ AloJ" on a message ----------------
+
+    public static void showForMessage(ChatActivity f, MessageObject m) {
+        Activity a = f.getParentActivity();
+        if (a == null || m == null || m.messageText == null) return;
+        final String text = m.messageText.toString();
+        final boolean money = AloJChatTools.hasMoney(text);
+        ArrayList<CharSequence> items = new ArrayList<>();
+        ArrayList<Integer> icons = new ArrayList<>();
+        final ArrayList<Integer> actions = new ArrayList<>();
+        items.add(L.t("Tarjima qilish (istalgan tilga)", "Перевести (на любой язык)")); icons.add(R.drawable.msg_translate); actions.add(1);
