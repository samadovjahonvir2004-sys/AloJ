+    /** Called at the start of ChatActivityEnterView.sendMessageInternal. Returns true when sending is postponed until translation finishes. */
+    public static boolean interceptSend(ChatActivity f, Runnable resend) {
+        if (f == null) return false;
+        if (skipNextSend) {
+            skipNextSend = false;
+            return false;
+        }
+        String lang = translateMode(f.getDialogId());
+        if (lang == null) return false;
+        CharSequence text = field(f);
+        if (text == null || text.toString().trim().isEmpty()) return false;
+        translate(f, text.toString(), lang, result -> {
+            setField(f, result);
+            skipNextSend = true;
+            resend.run();
+        });
+        return true;
+    }
