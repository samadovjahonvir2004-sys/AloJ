+    public static String uploadBannerImage(byte[] jpeg) throws Exception {
+        String path = "banners/" + UUID.randomUUID().toString() + ".jpg";
+        http("POST", "/storage/v1/object/photos/" + path, jpeg, "image/jpeg", token(), null);
+        return URL_BASE + "/storage/v1/object/public/photos/" + path;
+    }
+
+    public static ArrayList<Banner> banners() {
+        ArrayList<Banner> list = new ArrayList<>();
+        try {
+            JSONArray a = new JSONArray(json("GET", "/rest/v1/banners?select=*&order=sort.asc", null, false, null));
+            for (int i = 0; i < a.length(); i++) {
+                JSONObject o = a.getJSONObject(i);
+                Banner b = new Banner();
+                b.id = o.optLong("id");
+                b.sort = o.optInt("sort");
+                b.title = o.optString("title");
+                b.subtitle = o.isNull("subtitle") ? "" : o.optString("subtitle");
+                b.imageUrl = o.isNull("image_url") ? null : o.optString("image_url");
+                b.link = o.isNull("link") ? null : o.optString("link");
