+package uz.aloj;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+
+/** AloJ: user switches for the extra (Plus-style) features. */
+public final class AloJConfig {
+    public static boolean hideTyping;
+    public static boolean hideOnline;
+    public static boolean hideStories;
+    public static boolean confirmSticker;
+    public static boolean confirmVoice;
+    private static boolean loaded;
+
+    private AloJConfig() {}
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("aloj", Context.MODE_PRIVATE);
+    }
+
+    public static synchronized void load() {
+        if (loaded || ApplicationLoader.applicationContext == null) return;
+        SharedPreferences p = prefs();
+        hideTyping = p.getBoolean("hideTyping", false);
+        hideOnline = p.getBoolean("hideOnline", false);
+        hideStories = p.getBoolean("hideStories", false);
+        confirmSticker = p.getBoolean("confirmSticker", false);
+        confirmVoice = p.getBoolean("confirmVoice", false);
+        loaded = true;
+    }
+
+    public static boolean hideTyping() { load(); return hideTyping; }
+    public static boolean hideOnline() { load(); return hideOnline; }
+    public static boolean hideStories() { load(); return hideStories; }
+
+    public static boolean simpleMode() {
+        return prefs().getBoolean("simpleMode", false);
+    }
+
+    public static void setSimpleMode(boolean on) {
+        prefs().edit().putBoolean("simpleMode", on).apply();
+        set("hideStories", on);
+        SharedPreferences main = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", Context.MODE_PRIVATE);
+        int size = on ? 20 : 16;
+        org.telegram.messenger.SharedConfig.fontSize = size;
+        org.telegram.messenger.SharedConfig.fontSizeIsDefault = !on;
+        if (on) main.edit().putInt("fons_size", size).commit();
+        else main.edit().remove("fons_size").commit();
+        try {
+            org.telegram.ui.ActionBar.Theme.createCommonMessageResources();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    public static void set(String key, boolean value) {
+        load();
+        switch (key) {
+            case "hideTyping": hideTyping = value; break;
+            case "hideOnline": hideOnline = value; break;
+            case "hideStories": hideStories = value; break;
+            case "confirmSticker": confirmSticker = value; break;
+            case "confirmVoice": confirmVoice = value; break;
+        }
+        prefs().edit().putBoolean(key, value).apply();
+    }
+}
