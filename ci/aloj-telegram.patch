+    private static void scan(ChatActivity f, boolean manual) {
+        if (f.getParentActivity() == null) return;
+        long did = f.getDialogId();
+        TLRPC.User u = f.getCurrentUser();
+        if (!manual) {
+            if (u == null || u.contact || u.self || u.bot || u.id == 777000 || scanned.contains(did)) return;
+        }
+        ArrayList<String> reasons = new ArrayList<>();
+        ArrayList<MessageObject> list = f.messages;
+        int n = 0;
+        for (int i = 0; list != null && i < list.size() && n < 60; i++) {
+            MessageObject m = list.get(i);
+            if (m == null || m.isOut() || m.messageText == null) continue;
+            n++;
+            String t = m.messageText.toString();
+            if (CARD.matcher(t).find() && MONEY_ASK.matcher(t).find() && !reasons.contains("card")) reasons.add("card");
+            else if (MONEY_ASK.matcher(t).find() && !reasons.contains("money")) reasons.add("money");
+            if (CODE_ASK.matcher(t).find() && !reasons.contains("code")) reasons.add("code");
+            if (PRIZE.matcher(t).find() && !reasons.contains("prize")) reasons.add("prize");
+            if (BAD_LINK.matcher(t).find() && !reasons.contains("link")) reasons.add("link");
+            if (m.getDocument() != null && m.getDocumentName() != null && m.getDocumentName().toLowerCase().endsWith(".apk") && !reasons.contains("apk")) reasons.add("apk");
+        }
+        if (!manual) scanned.add(did);
+        if (reasons.isEmpty()) {
+            if (manual) toast(f, uz.aloj.L.t("✅ Shubhali narsa topilmadi. Baribir oldindan pul o'tkazmang!", "✅ Ничего подозрительного. Всё равно не переводите предоплату!"));
+            return;
+        }
+        StringBuilder sb = new StringBuilder();
+        if (u != null && !u.contact && !u.self) sb.append(uz.aloj.L.t("Bu odam kontaktlaringizda yo'q.\n\n", "Этого человека нет в ваших контактах.\n\n"));
+        for (String r : reasons) {
+            switch (r) {
+                case "card": sb.append(uz.aloj.L.t("💳 Karta raqami va oldindan to'lov so'ralmoqda — bu eng ko'p uchraydigan aldov.\n", "💳 Просят номер карты и предоплату — самый частый обман.\n")); break;
+                case "money": sb.append(uz.aloj.L.t("💸 Oldindan pul / avans so'ralmoqda.\n", "💸 Просят предоплату / аванс.\n")); break;
+                case "code": sb.append(uz.aloj.L.t("🔑 SMS kod yoki parol so'ralmoqda — HECH KIMGA aytmang, akkauntingiz o'g'irlanadi.\n", "🔑 Просят SMS-код или пароль — НИКОМУ не говорите, украдут аккаунт.\n")); break;
+                case "prize": sb.append(uz.aloj.L.t("🎁 \"Yutib oldingiz\" / sovrin haqidagi xabar — odatda firibgarlik.\n", "🎁 «Вы выиграли» / приз — обычно мошенничество.\n")); break;
+                case "link": sb.append(uz.aloj.L.t("🔗 Shubhali havola (soxta sayt yoki qisqartirilgan link).\n", "🔗 Подозрительная ссылка (фейковый сайт или сокращённая ссылка).\n")); break;
+                case "apk": sb.append(uz.aloj.L.t("📦 .apk fayl yuborilgan — o'rnatmang, telefoningiz buziladi.\n", "📦 Прислан .apk файл — не устанавливайте, это опасно.\n")); break;
+            }
+        }
+        sb.append(uz.aloj.L.t("\nAloJ maslahati: mahsulotni ko'rmasdan pul o'tkazmang, kodlarni hech kimga bermang.", "\nСовет AloJ: не переводите деньги, не увидев товар, и никому не сообщайте коды."));
+        AlertDialog.Builder b = new AlertDialog.Builder(f.getParentActivity(), f.getResourceProvider());
+        b.setTitle(uz.aloj.L.t("⚠️ Ehtiyot bo'ling!", "⚠️ Осторожно!"));
+        b.setMessage(sb.toString());
+        b.setPositiveButton(uz.aloj.L.t("Tushundim", "Понятно"), null);
+        f.showDialog(b.create());
