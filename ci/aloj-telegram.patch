+        } catch (ApiException e) {
+            if (auth && e.code == 401) {
+                prefs().edit().remove("access").remove("exp").apply();
+                return http(method, path, body == null ? null : body.getBytes("UTF-8"), "application/json", token(), prefer);
+            }
+            throw e;
+        }
+    }
