+    // ---------------- formatting ----------------
+
+    public static String price(Listing l) {
+        if (l.price <= 0) return uz.aloj.L.t("Kelishilgan", "Договорная");
+        if ("USD".equals(l.currency)) return "$" + group((long) Math.round(l.price));
+        return group((long) Math.round(l.price)) + uz.aloj.L.t(" so'm", " сум");
+    }
+
+    public static String group(long v) {
+        String s = String.valueOf(v);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            if (i > 0 && (s.length() - i) % 3 == 0) sb.append(' ');
+            sb.append(s.charAt(i));
+        }
+        return sb.toString();
+    }
+
+    public static String categoryName(String id) {
+        for (int i = 0; i < CATEGORY_IDS.length; i++) if (CATEGORY_IDS[i].equals(id)) return CATEGORY_NAMES[i];
+        return id;
+    }
+
+    public static String ago(String iso) {
+        try {
+            java.text.SimpleDateFormat f = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss", java.util.Locale.US);
+            f.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
+            long t = f.parse(iso.substring(0, 19)).getTime();
+            long d = (System.currentTimeMillis() - t) / 1000;
+            if (d < 3600) return Math.max(1, d / 60) + uz.aloj.L.t(" daqiqa oldin", " мин. назад");
+            if (d < 86400) return (d / 3600) + uz.aloj.L.t(" soat oldin", " ч. назад");
+            if (d < 172800) return uz.aloj.L.t("kecha", "вчера");
+            return (d / 86400) + uz.aloj.L.t(" kun oldin", " дн. назад");
+        } catch (Throwable e) {
+            return "";
+        }
+    }
+
+    public static String errorText(Throwable e) {
+        if (e instanceof ApiException) {
+            String m = e.getMessage() == null ? "" : e.getMessage();
+            if (m.contains("FREE_LIMIT")) return uz.aloj.L.t("Sizda 2 ta bepul e'lon bor. Yangisini joylash uchun eskisini \"Sotildi\" qiling yoki o'chiring.", "У вас 2 бесплатных объявления. Чтобы добавить новое, отметьте старое «Продано» или удалите.");
+            if (m.contains("anonymous") || m.contains("Anonymous")) return "Bozor hali sozlanmagan (anonim kirish o'chiq).";
+            return uz.aloj.L.t("Server xatosi (", "Ошибка сервера (") + ((ApiException) e).code + ")";
+        }
+        return uz.aloj.L.t("Internet bilan muammo. Qayta urinib ko'ring.", "Проблема с интернетом. Попробуйте ещё раз.");
+    }
+}
