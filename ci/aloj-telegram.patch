+            o.inJustDecodeBounds = true;
+            InputStream in = ctx.getContentResolver().openInputStream(uri);
+            BitmapFactory.decodeStream(in, null, o);
+            in.close();
+            int sample = 1;
+            while (Math.max(o.outWidth, o.outHeight) / (sample * 2) >= max) sample *= 2;
+            BitmapFactory.Options o2 = new BitmapFactory.Options();
+            o2.inSampleSize = sample;
+            in = ctx.getContentResolver().openInputStream(uri);
+            Bitmap b = BitmapFactory.decodeStream(in, null, o2);
+            in.close();
+            if (b == null) return null;
+            int rotation = 0;
+            try {
+                in = ctx.getContentResolver().openInputStream(uri);
+                ExifInterface exif = new ExifInterface(in);
+                int or = exif.getAttributeInt(ExifInterface.TAG_ORIENTATION, ExifInterface.ORIENTATION_NORMAL);
+                rotation = or == ExifInterface.ORIENTATION_ROTATE_90 ? 90 : or == ExifInterface.ORIENTATION_ROTATE_180 ? 180 : or == ExifInterface.ORIENTATION_ROTATE_270 ? 270 : 0;
+                in.close();
+            } catch (Throwable ignore) {
+            }
+            float scale = Math.min(1f, max / (float) Math.max(b.getWidth(), b.getHeight()));
+            if (scale < 1f || rotation != 0) {
+                Matrix m = new Matrix();
+                m.postScale(scale, scale);
+                m.postRotate(rotation);
+                Bitmap r = Bitmap.createBitmap(b, 0, 0, b.getWidth(), b.getHeight(), m, true);
+                if (r != b) b.recycle();
+                b = r;
+            }
+            return b;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    private void pickCategory() {
+        if (getParentActivity() == null) return;
+        String[] names = new String[BozorApi.CATEGORY_IDS.length];
+        for (int i = 0; i < names.length; i++) names[i] = BozorApi.CATEGORY_EMOJI[i] + "  " + BozorApi.CATEGORY_NAMES[i];
+        AlertDialog.Builder b = new AlertDialog.Builder(getParentActivity(), getResourceProvider());
+        b.setTitle(uz.aloj.L.t("Kategoriya", "Категория"));
+        b.setItems(names, (d, w) -> {
+            category = BozorApi.CATEGORY_IDS[w];
+            categoryBtn.setText(names[w]);
+        });
+        showDialog(b.create());
+    }
+
+    private void pickCity() {
+        if (getParentActivity() == null) return;
+        AlertDialog.Builder b = new AlertDialog.Builder(getParentActivity(), getResourceProvider());
+        b.setTitle(uz.aloj.L.t("Shahar / viloyat", "Город / область"));
+        b.setItems(BozorApi.CITIES, (d, w) -> {
+            city = BozorApi.CITIES[w];
+            cityBtn.setText("📍 " + city + " ▾");
+        });
+        showDialog(b.create());
+    }
+
+    private void send() {
+        if (sending) return;
+        String t = title.getText().toString().trim();
+        String p = price.getText().toString().replaceAll("[^0-9]", "");
+        if (t.length() < 3) {
+            BozorUi.toast(this, uz.aloj.L.t("E'lon nomini yozing (kamida 3 harf)", "Введите название (минимум 3 буквы)"));
+            return;
+        }
+        if (category == null) {
+            BozorUi.toast(this, uz.aloj.L.t("Kategoriyani tanlang", "Выберите категорию"));
+            return;
+        }
+        if (photos.isEmpty()) {
+            BozorUi.toast(this, uz.aloj.L.t("Kamida bitta rasm qo'shing — rasmli e'lonlar 5 barobar tez sotiladi", "Добавьте хотя бы одно фото — с фото продаётся в 5 раз быстрее"));
+            return;
+        }
+        final BozorApi.Listing l = new BozorApi.Listing();
+        TLRPC.User me = UserConfig.getInstance(currentAccount).getCurrentUser();
+        if (me != null) {
+            l.tgId = me.id;
+            String uname = UserObject.getPublicUsername(me);
+            l.tgName = uname != null && uname.length() > 0 ? "@" + uname : UserObject.getFirstName(me);
+        }
+        l.title = t;
+        l.description = description.getText().toString().trim();
+        try {
+            l.price = p.isEmpty() ? 0 : Double.parseDouble(p);
+        } catch (Throwable e) {
+            l.price = 0;
+        }
+        l.currency = currency;
+        l.category = category;
+        l.city = city;
+        l.condition = condition;
+        sending = true;
+        submit.setText(uz.aloj.L.t("Yuklanmoqda...", "Загрузка..."));
+        final ArrayList<Bitmap> toSend = new ArrayList<>(photos);
+        Utilities.globalQueue.postRunnable(() -> {
+            String err = null;
+            try {
+                for (Bitmap b : toSend) {
+                    ByteArrayOutputStream bos = new ByteArrayOutputStream();
+                    b.compress(Bitmap.CompressFormat.JPEG, 80, bos);
+                    l.photos.add(BozorApi.uploadPhoto(bos.toByteArray()));
+                }
+                BozorApi.create(l);
+            } catch (Throwable e) {
+                err = BozorApi.errorText(e);
+            }
+            final String er = err;
+            AndroidUtilities.runOnUIThread(() -> {
+                sending = false;
+                if (submit != null) submit.setText(uz.aloj.L.t("E'lonni joylash", "Опубликовать"));
+                if (er != null) {
+                    BozorUi.toast(this, er);
+                    return;
+                }
+                changed = true;
+                BozorUi.toast(this, uz.aloj.L.t("E'loningiz joylandi! 🎉", "Объявление опубликовано! 🎉"));
+                finishFragment();
+            });
+        });
+    }
+}
