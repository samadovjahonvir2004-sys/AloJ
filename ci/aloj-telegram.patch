diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/AloJBrand.java b/TMessagesProj/src/main/java/org/telegram/messenger/AloJBrand.java
new file mode 100644
index 0000000..969ef3b
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/AloJBrand.java
@@ -0,0 +1,29 @@
+package org.telegram.messenger;
+
+import java.util.regex.Pattern;
+
+/** AloJ: shows the AloJ name instead of Telegram/Nagram in interface texts.
+ *  Names of Telegram's own paid services (Premium, Stars, ...) are kept as they are. */
+public final class AloJBrand {
+    private static final Pattern P1 = Pattern.compile("Nagram|NekoX|Nekogram");
+    private static final Pattern P2 = Pattern.compile("(?<![@/\\.\\w-])Telegram(?!\\s?(?:Premium|Stars|Business|Gateway|Passport|Wallet|Gift|Gifts|Fragment|API))(?!\\.[A-Za-z])(?![\\w/-])");
+    private static final Pattern P3 = Pattern.compile("(?<![\\p{L}])Телеграм(?:ме|ма|му|мом|е|а|у|ом)?(?![\\p{L}])");
+
+    /** Telegram's own paid services keep the Telegram name (in any language). */
+    private static final Pattern PAID = Pattern.compile("Premium|Stars|Gift|Business|Премиум|Звёзд|Звезд|бизнес|Бизнес|подар|Подар|Fragment|Wallet|Кошел", Pattern.UNICODE_CASE);
+
+    private AloJBrand() {}
+
+    public static String apply(String s) {
+        if (s == null || s.isEmpty()) return s;
+        if (s.indexOf("Telegram") < 0 && s.indexOf("Телеграм") < 0 && s.indexOf("Nagram") < 0
+                && s.indexOf("NekoX") < 0 && s.indexOf("Nekogram") < 0) {
+            return s;
+        }
+        s = P1.matcher(s).replaceAll("AloJ");
+        if (PAID.matcher(s).find()) return s;
+        s = P2.matcher(s).replaceAll("AloJ");
+        s = P3.matcher(s).replaceAll("AloJ");
+        return s;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/AloJCrash.java b/TMessagesProj/src/main/java/org/telegram/messenger/AloJCrash.java
new file mode 100644
index 0000000..4dc84fe
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/AloJCrash.java
@@ -0,0 +1,78 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.os.Process;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+
+/** AloJ: catches a crash, saves the reason and shows it in AloJCrashActivity so the user can copy it. */
+public final class AloJCrash {
+    private static boolean installed;
+
+    private AloJCrash() {}
+
+    /** True inside the separate ":aloj_crash" process that only shows the crash screen. */
+    public static boolean isCrashProcess() {
+        try {
+            byte[] buf = new byte[256];
+            java.io.FileInputStream in = new java.io.FileInputStream("/proc/self/cmdline");
+            int n = in.read(buf);
+            in.close();
+            if (n > 0) {
+                String name = new String(buf, 0, n, "UTF-8").trim();
+                int z = name.indexOf('\0');
+                if (z >= 0) name = name.substring(0, z);
+                return name.endsWith(":aloj_crash");
+            }
+        } catch (Throwable ignore) {
+        }
+        return false;
+    }
+
+    public static File file(Context ctx) {
+        return new File(ctx.getFilesDir(), "aloj_last_crash.txt");
+    }
+
+    public static synchronized void install(final Context ctx) {
+        if (installed || ctx == null) return;
+        installed = true;
+        final Context app = ctx.getApplicationContext() != null ? ctx.getApplicationContext() : ctx;
+        final Thread.UncaughtExceptionHandler previous = Thread.getDefaultUncaughtExceptionHandler();
+        final Thread.UncaughtExceptionHandler handler = (thread, error) -> {
+            try {
+                StringWriter sw = new StringWriter();
+                PrintWriter pw = new PrintWriter(sw);
+                pw.println("AloJ " + BuildVars.BUILD_VERSION_STRING);
+                pw.println("Android " + Build.VERSION.RELEASE + " / SDK " + Build.VERSION.SDK_INT + " / " + Build.MANUFACTURER + " " + Build.MODEL);
+                pw.println("Thread: " + thread.getName());
+                pw.println();
+                error.printStackTrace(pw);
+                pw.flush();
+                FileOutputStream out = new FileOutputStream(file(app));
+                out.write(sw.toString().getBytes("UTF-8"));
+                out.close();
+                Intent i = new Intent(app, org.telegram.ui.AloJCrashActivity.class);
+                i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+                app.startActivity(i);
+            } catch (Throwable ignore) {
+            }
+            try {
+                Process.killProcess(Process.myPid());
+            } catch (Throwable ignore) {
+            }
+            if (previous != null) previous.uncaughtException(thread, error);
+            System.exit(10);
+        };
+        Thread.setDefaultUncaughtExceptionHandler(handler);
+        // Nagram sets its own silent handler on the main thread; replace it so crashes are shown.
+        try {
+            android.os.Looper.getMainLooper().getThread().setUncaughtExceptionHandler(handler);
+        } catch (Throwable ignore) {
+        }
+    }
+}
