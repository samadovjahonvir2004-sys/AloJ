@@ -0,0 +1,201 @@
+package uz.aloj.bozor;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BackupImageView;
+import org.telegram.ui.Components.LayoutHelper;
+
+/** AloJ Bozor: shared look (colors, cards, chips). */
+public final class BozorUi {
+    public static final int ORANGE = 0xFFFF8A3D;
+    public static final int ORANGE_DARK = 0xFFE8712A;
+    public static final int GOLD = 0xFFFFC531;
+
+    private BozorUi() {}
+
+    public static int bg(BaseFragment f) {
+        return Theme.getColor(Theme.key_windowBackgroundGray, f.getResourceProvider());
+    }
+
+    public static int card(BaseFragment f) {
+        return Theme.getColor(Theme.key_windowBackgroundWhite, f.getResourceProvider());
+    }
+
+    public static int text(BaseFragment f) {
+        return Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, f.getResourceProvider());
+    }
+
+    public static int gray(BaseFragment f) {
+        return Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, f.getResourceProvider());
+    }
+
+    public static boolean dark(BaseFragment f) {
+        return AndroidUtilities.computePerceivedBrightness(card(f)) < 0.5f;
+    }
+
+    public static int soft(BaseFragment f) {
+        return dark(f) ? 0x33FF8A3D : 0xFFFFF3EA;
+    }
+
+    public static TextView text(Context ctx, int color, float sp, boolean bold) {
+        TextView t = new TextView(ctx);
+        t.setTextColor(color);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_DIP, sp);
+        if (bold) t.setTypeface(AndroidUtilities.bold());
+        return t;
+    }
+
+    public static GradientDrawable round(int color, float radiusDp) {
+        GradientDrawable d = new GradientDrawable();
+        d.setColor(color);
+        d.setCornerRadius(dp(radiusDp));
+        return d;
+    }
+
+    public static GradientDrawable stroke(int fill, int strokeColor, float radiusDp) {
+        GradientDrawable d = round(fill, radiusDp);
+        d.setStroke(dp(1.5f), strokeColor);
+        return d;
+    }
+
+    public static GradientDrawable brandGradient(float radiusDp) {
+        GradientDrawable d = new GradientDrawable(GradientDrawable.Orientation.TL_BR, new int[]{0xFF5B3DF5, 0xFFE0457B, 0xFFFF9A2E});
+        d.setCornerRadius(dp(radiusDp));
+        return d;
+    }
+
+    public static TextView button(Context ctx, String label, boolean primary) {
+        TextView b = text(ctx, primary ? Color.WHITE : ORANGE_DARK, 15, true);
+        b.setText(label);
+        b.setGravity(Gravity.CENTER);
+        b.setPadding(dp(16), dp(13), dp(16), dp(13));
+        b.setBackground(Theme.createSimpleSelectorRoundRectDrawable(dp(14), primary ? ORANGE : 0x1FFF8A3D, primary ? ORANGE_DARK : 0x33FF8A3D));
+        return b;
+    }
+
+    public static TextView chip(Context ctx, BaseFragment f, String label, boolean selected) {
+        TextView c = text(ctx, selected ? ORANGE_DARK : text(f), 13, selected);
+        c.setText(label);
+        c.setGravity(Gravity.CENTER);
+        c.setPadding(dp(14), dp(8), dp(14), dp(8));
+        c.setBackground(stroke(selected ? soft(f) : card(f), selected ? ORANGE : (dark(f) ? 0x22FFFFFF : 0xFFEBEBEB), 10));
+        return c;
+    }
+
+    /** Grid card: photo, TOP badge, title, price, place/time. */
+    public static View listingCard(Context ctx, BaseFragment f, BozorApi.Listing l, int widthPx) {
+        LinearLayout box = new LinearLayout(ctx);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setBackground(round(card(f), 14));
+        box.setClipToOutline(true);
+        box.setElevation(dp(1.5f));
+
+        FrameLayout photo = new FrameLayout(ctx);
+        photo.setBackgroundColor(dark(f) ? 0xFF2A2A30 : 0xFFF1F2F6);
+        BackupImageView img = new BackupImageView(ctx);
+        if (!l.photos.isEmpty()) {
+            img.setImage(l.photos.get(0), "300_300", null);
+        } else {
+            TextView ph = text(ctx, gray(f), 40, false);
+            ph.setText(emoji(l.category));
+            ph.setGravity(Gravity.CENTER);
+            photo.addView(ph, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        }
+        photo.addView(img, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        if (l.top) {
+            TextView top = text(ctx, 0xFF5A3C00, 10, true);
+            top.setText("TOP");
+            top.setPadding(dp(6), dp(2), dp(6), dp(2));
+            top.setBackground(round(GOLD, 6));
+            photo.addView(top, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP | Gravity.LEFT, 6, 6, 0, 0));
+        }
+        if ("sold".equals(l.status)) {
+            TextView sold = text(ctx, Color.WHITE, 11, true);
+            sold.setText(uz.aloj.L.t("SOTILDI", "ПРОДАНО"));
+            sold.setPadding(dp(6), dp(2), dp(6), dp(2));
+            sold.setBackground(round(0xCC000000, 6));
+            photo.addView(sold, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP | Gravity.RIGHT, 0, 6, 6, 0));
+        }
+        box.addView(photo, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, (int) (widthPx * 0.8f)));
+
+        TextView title = text(ctx, text(f), 13, false);
+        title.setText(l.title);
+        title.setMaxLines(2);
+        title.setEllipsize(TextUtils.TruncateAt.END);
+        title.setPadding(dp(9), dp(7), dp(9), 0);
+        box.addView(title);
+        TextView price = text(ctx, text(f), 15, true);
+        price.setText(BozorApi.price(l));
+        price.setPadding(dp(9), dp(2), dp(9), 0);
+        box.addView(price);
+        TextView place = text(ctx, gray(f), 11, false);
+        place.setText(l.city + " · " + BozorApi.ago(l.createdAt) + (l.views > 0 ? " · 👁 " + l.views : ""));
+        place.setSingleLine(true);
+        place.setEllipsize(TextUtils.TruncateAt.END);
+        place.setPadding(dp(9), dp(2), dp(9), dp(9));
+        box.addView(place);
+        return box;
+    }
+
+    /** Telegram's new action bar is drawn over the content: push the content below it. */
+    public static void fitUnderActionBar(BaseFragment f, View content) {
+        content.post(() -> {
+            if (f.getActionBar() == null) return;
+            int[] a = new int[2];
+            int[] b = new int[2];
+            f.getActionBar().getLocationInWindow(a);
+            content.getLocationInWindow(b);
+            int top = a[1] + f.getActionBar().getHeight() - b[1];
+            if (top > 0 && content.getPaddingTop() < top) {
+                content.setPadding(content.getPaddingLeft(), top + content.getPaddingTop(), content.getPaddingRight(), content.getPaddingBottom());
+            }
+        });
+    }
+
+    public static String emoji(String category) {
+        for (int i = 0; i < BozorApi.CATEGORY_IDS.length; i++) {
+            if (BozorApi.CATEGORY_IDS[i].equals(category)) return BozorApi.CATEGORY_EMOJI[i];
+        }
+        return "📦";
+    }
+
+    public static void toast(BaseFragment f, String s) {
+        if (f.getParentActivity() != null) Toast.makeText(f.getParentActivity(), s, Toast.LENGTH_LONG).show();
+    }
+
+    /** Opens the AloJ chat with the seller. */
+    public static void openSeller(BaseFragment f, BozorApi.Listing l) {
+        int acc = UserConfig.selectedAccount;
+        if (l.tgName != null && l.tgName.startsWith("@") && l.tgName.length() > 1) {
+            MessagesController.getInstance(acc).openByUserName(l.tgName.substring(1), f, 1);
+            return;
+        }
+        TLRPC.User u = l.tgId != 0 ? MessagesController.getInstance(acc).getUser(l.tgId) : null;
+        if (u != null) {
+            android.os.Bundle args = new android.os.Bundle();
+            args.putLong("user_id", u.id);
+            f.presentFragment(new ChatActivity(args));
+        } else {
+            toast(f, uz.aloj.L.t("Sotuvchining username'i yo'q. E'lon tavsifidagi telefon raqami orqali bog'laning.", "У продавца нет username. Свяжитесь по телефону из описания."));
+        }
+    }
+}
