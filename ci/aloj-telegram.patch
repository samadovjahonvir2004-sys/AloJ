@@ -0,0 +1,65 @@
+package uz.aloj;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** AloJ: official exchange rates of the Central Bank of Uzbekistan (cbu.uz, free public JSON). */
+public final class AloJRates {
+    private AloJRates() {}
+
+    public static final String URL_RATES = "https://cbu.uz/uz/arkhiv-kursov-valyut/json/";
+    public static volatile Map<String, Double> cache;
+    public static volatile String cacheDate;
+    public static volatile long cacheTime;
+
+    /** Blocking call: run it off the UI thread. Returns code -> so'm per 1 unit. */
+    public static Map<String, Double> load() throws Exception {
+        if (cache != null && System.currentTimeMillis() - cacheTime < 3 * 60 * 60 * 1000L) {
+            return cache;
+        }
+        HttpURLConnection c = (HttpURLConnection) new URL(URL_RATES).openConnection();
+        c.setConnectTimeout(10000);
+        c.setReadTimeout(10000);
+        StringBuilder sb = new StringBuilder();
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(c.getInputStream(), "UTF-8"))) {
+            String line;
+            while ((line = r.readLine()) != null) sb.append(line);
+        } finally {
+            c.disconnect();
+        }
+        JSONArray arr = new JSONArray(sb.toString());
+        Map<String, Double> m = new LinkedHashMap<>();
+        String date = null;
+        for (int i = 0; i < arr.length(); i++) {
+            JSONObject o = arr.getJSONObject(i);
+            String ccy = o.optString("Ccy");
+            double rate = Double.parseDouble(o.optString("Rate", "0").replace(",", "."));
+            double nominal = Double.parseDouble(o.optString("Nominal", "1").replace(",", "."));
+            if (nominal <= 0) nominal = 1;
+            m.put(ccy, rate / nominal);
+            if (date == null) date = o.optString("Date");
+        }
+        cache = m;
+        cacheDate = date;
+        cacheTime = System.currentTimeMillis();
+        return m;
+    }
+
+    public static String formatSom(double v) {
+        long r = Math.round(v);
+        String s = String.valueOf(Math.abs(r));
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            if (i > 0 && (s.length() - i) % 3 == 0) out.append(' ');
+            out.append(s.charAt(i));
+        }
+        return (r < 0 ? "-" : "") + out + uz.aloj.L.t(" so'm", " сум");
+    }
+}
diff --git a/TMessagesProj/src/main/java/uz/aloj/AloJTranslit.java b/TMessagesProj/src/main/java/uz/aloj/AloJTranslit.java
