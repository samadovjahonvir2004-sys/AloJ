@@ -0,0 +1,153 @@
+package uz.aloj;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.util.TypedValue;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.Utilities;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+
+import java.util.ArrayList;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** AloJ: tools shown in the message long-press menu. */
+public final class AloJChatTools {
+    public static final int OPTION_MONEY = 9001;
+    public static final int OPTION_TRANSLIT = 9002;
+    public static final int OPTION_ALOJ = 9003;
+
+    private static final String NUM = "(\\d{1,3}(?:[ \\u00a0.,]\\d{3})+|\\d+)(?:[.,](\\d{1,2}))?\\s*(k|ming|тыс)?";
+    private static final String CUR = "(\\$|usd|dollar|dollor|долл\\w*|€|eur|euro|yevro|евро|₽|rub|rubl\\w*|руб\\w*|£|gbp|kzt|tenge|тенге|¥|cny|yuan|aed|dirham|дирхам|tl|try|lira)";
+    private static final Pattern AFTER = Pattern.compile(NUM + "\\s*" + CUR + "(?![\\p{L}])", Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE);
+    private static final Pattern BEFORE = Pattern.compile(CUR + "\\s*" + NUM, Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE);
+
+    private AloJChatTools() {}
+
+    private static final class Amount {
+        final double value;
+        final String code;
+        final String raw;
+        Amount(double v, String c, String r) { value = v; code = c; raw = r; }
+    }
+
+    private static String code(String c) {
+        c = c.toLowerCase();
+        if (c.equals("$") || c.startsWith("usd") || c.startsWith("dollar") || c.startsWith("dollor") || c.startsWith("долл")) return "USD";
+        if (c.equals("€") || c.startsWith("eur") || c.startsWith("yevro") || c.startsWith("евро")) return "EUR";
+        if (c.equals("₽") || c.startsWith("rub") || c.startsWith("руб")) return "RUB";
+        if (c.equals("£") || c.equals("gbp")) return "GBP";
+        if (c.equals("kzt") || c.startsWith("tenge") || c.startsWith("тенге")) return "KZT";
+        if (c.equals("¥") || c.equals("cny") || c.equals("yuan")) return "CNY";
+        if (c.equals("aed") || c.startsWith("dirham") || c.startsWith("дирхам")) return "AED";
+        return "TRY";
+    }
+
+    private static double num(String whole, String frac, String mult) {
+        double v = Double.parseDouble(whole.replaceAll("[ \\u00a0.,]", ""));
+        if (frac != null) v += Double.parseDouble("0." + frac);
+        if (mult != null) v *= 1000;
+        return v;
+    }
+
+    private static ArrayList<Amount> find(CharSequence text) {
+        ArrayList<Amount> list = new ArrayList<>();
+        if (text == null) return list;
+        String s = text.toString();
+        try {
+            Matcher m = AFTER.matcher(s);
+            while (m.find() && list.size() < 6) list.add(new Amount(num(m.group(1), m.group(2), m.group(3)), code(m.group(4)), m.group().trim()));
+            m = BEFORE.matcher(s);
+            while (m.find() && list.size() < 6) list.add(new Amount(num(m.group(2), m.group(3), m.group(4)), code(m.group(1)), m.group().trim()));
+        } catch (Throwable ignore) {
+        }
+        return list;
+    }
+
+    public static boolean hasMoney(CharSequence text) {
+        return !find(text).isEmpty();
+    }
+
+    public static void handle(BaseFragment fragment, int option, CharSequence text) {
+        if (fragment == null || fragment.getParentActivity() == null || text == null) return;
+        if (option == OPTION_TRANSLIT) {
+            showTranslit(fragment, text.toString());
+        } else if (option == OPTION_MONEY) {
+            final ArrayList<Amount> amounts = find(text);
+            Toast.makeText(fragment.getParentActivity(), uz.aloj.L.t("Kurs yuklanmoqda...", "Загрузка курса..."), Toast.LENGTH_SHORT).show();
+            Utilities.globalQueue.postRunnable(() -> {
+                Map<String, Double> rates = null;
+                try {
+                    rates = AloJRates.load();
+                } catch (Throwable ignore) {
+                }
+                final Map<String, Double> r = rates;
+                AndroidUtilities.runOnUIThread(() -> showMoney(fragment, amounts, r));
+            });
+        }
+    }
+
+    private static TextView body(Context ctx, BaseFragment f, CharSequence text) {
+        TextView t = new TextView(ctx);
+        t.setText(text);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        t.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, f.getResourceProvider()));
+        t.setTextIsSelectable(true);
+        t.setLineSpacing(dp(3), 1f);
+        return t;
+    }
+
+    private static void showMoney(BaseFragment f, ArrayList<Amount> amounts, Map<String, Double> rates) {
+        Context ctx = f.getParentActivity();
+        if (ctx == null) return;
+        if (rates == null || rates.isEmpty()) {
+            Toast.makeText(ctx, uz.aloj.L.t("Kursni yuklab bo'lmadi. Internetni tekshiring.", "Не удалось загрузить курс. Проверьте интернет."), Toast.LENGTH_SHORT).show();
+            return;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (Amount a : amounts) {
+            Double rate = rates.get(a.code);
+            if (rate == null) continue;
+            sb.append(a.raw).append("  ≈  ").append(AloJRates.formatSom(a.value * rate)).append('\n');
+        }
+        if (sb.length() == 0) sb.append(uz.aloj.L.t("Bu valyuta kursi topilmadi.", "Курс этой валюты не найден."));
+        if (AloJRates.cacheDate != null) sb.append(uz.aloj.L.t("\nMarkaziy bank kursi, ", "\nКурс ЦБ, ")).append(AloJRates.cacheDate);
+        LinearLayout box = new LinearLayout(ctx);
+        box.setPadding(dp(24), dp(4), dp(24), 0);
+        box.addView(body(ctx, f, sb.toString().trim()));
+        AlertDialog.Builder b = new AlertDialog.Builder(ctx, f.getResourceProvider());
+        b.setTitle(uz.aloj.L.t("So'mda qancha?", "Сколько в сумах?"));
+        b.setView(box);
+        b.setPositiveButton(uz.aloj.L.t("Yopish", "Закрыть"), null);
+        f.showDialog(b.create());
+    }
+
+    private static void showTranslit(BaseFragment f, String text) {
+        Context ctx = f.getParentActivity();
+        if (ctx == null) return;
+        final String result = AloJTranslit.toggle(text);
+        LinearLayout box = new LinearLayout(ctx);
+        box.setPadding(dp(24), dp(4), dp(24), 0);
+        box.addView(body(ctx, f, result));
+        AlertDialog.Builder b = new AlertDialog.Builder(ctx, f.getResourceProvider());
+        b.setTitle(uz.aloj.L.t("Lotin ↔ Kirill", "Латиница ↔ кириллица"));
+        b.setView(box);
+        b.setPositiveButton(uz.aloj.L.t("Nusxa olish", "Копировать"), (d, w) -> {
+            ClipboardManager cm = (ClipboardManager) ctx.getSystemService(Context.CLIPBOARD_SERVICE);
+            cm.setPrimaryClip(ClipData.newPlainText("AloJ", result));
+            Toast.makeText(ctx, uz.aloj.L.t("Nusxa olindi", "Скопировано"), Toast.LENGTH_SHORT).show();
+        });
+        b.setNegativeButton(uz.aloj.L.t("Yopish", "Закрыть"), null);
+        f.showDialog(b.create());
+    }
+}
