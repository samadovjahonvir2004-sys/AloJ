+        root.setBackgroundColor(BozorUi.bg(this));
+        ScrollView scroll = new ScrollView(context);
+        col = new LinearLayout(context);
+        col.setOrientation(LinearLayout.VERTICAL);
+        col.setPadding(dp(6), dp(6), dp(6), dp(24));
+        scroll.addView(col);
+        root.addView(scroll, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        BozorUi.fitUnderActionBar(this, col);
+        fragmentView = root;
+        load();
+        return fragmentView;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        if (col != null && BozorNewActivity.changed) {
+            load();
+        }
+    }
+
+    private void load() {
+        col.removeAllViews();
+        status = BozorUi.text(col.getContext(), BozorUi.gray(this), 14, false);
+        status.setGravity(Gravity.CENTER);
+        status.setPadding(dp(24), dp(40), dp(24), dp(24));
+        status.setText(uz.aloj.L.t("Yuklanmoqda...", "Загрузка..."));
+        col.addView(status);
+        Utilities.globalQueue.postRunnable(() -> {
+            ArrayList<BozorApi.Listing> res = null;
+            String err = null;
+            try {
+                res = favorites ? BozorApi.byIds(BozorApi.favIds()) : BozorApi.mine();
+            } catch (Throwable e) {
+                err = BozorApi.errorText(e);
+            }
+            final ArrayList<BozorApi.Listing> r = res;
+            final String er = err;
+            AndroidUtilities.runOnUIThread(() -> show(r, er));
+        });
+    }
+
+    private void addAdminLink() {
+        if (favorites || col == null) return;
+        TextView a = BozorUi.text(col.getContext(), BozorUi.gray(this), 12, false);
+        a.setText("AloJ Bozor · admin");
+        a.setGravity(Gravity.CENTER);
+        a.setPadding(dp(16), dp(28), dp(16), dp(16));
+        a.setOnLongClickListener(v -> {
+            BozorAdminActivity.open(this);
+            return true;
+        });
+        col.addView(a, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+    }
+
+    private void show(ArrayList<BozorApi.Listing> list, String err) {
+        if (col == null) return;
+        Context ctx = col.getContext();
+        if (err != null) {
+            status.setText(err);
+            return;
+        }
+        if (list == null || list.isEmpty()) {
+            addAdminLink();
+            status.setText(favorites ? uz.aloj.L.t("Sevimli e'lonlar yo'q.\nE'londagi ⭐ tugmasini bosing.", "Нет избранных.\nНажмите ⭐ в объявлении.") : uz.aloj.L.t("Sizda hali e'lon yo'q.\nBozorda \"E'lon berish\" tugmasini bosing.", "У вас пока нет объявлений.\nНажмите «Подать объявление» в Базаре."));
+            return;
+        }
+        col.removeAllViews();
+        int w = (AndroidUtilities.displaySize.x - dp(36)) / 2;
+        LinearLayout row = null;
+        for (int i = 0; i < list.size(); i++) {
+            if (i % 2 == 0) {
+                row = new LinearLayout(ctx);
+                col.addView(row);
+            }
+            BozorApi.Listing l = list.get(i);
+            View card = BozorUi.listingCard(ctx, this, l, w);
+            card.setOnClickListener(v -> presentFragment(new BozorItemActivity(l)));
+            row.addView(card, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f, 6, 6, 6, 6));
+        }
+        if (list.size() % 2 == 1 && row != null) {
+            row.addView(new View(ctx), LayoutHelper.createLinear(0, 1, 1f, 6, 6, 6, 6));
+        }
+        addAdminLink();
+    }
+}
