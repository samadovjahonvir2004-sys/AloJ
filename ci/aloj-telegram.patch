+    public interface Done {
+        void run(String result);
+    }
+
+    public static void translate(ChatActivity f, String text, String toLang, Done done) {
+        TLRPC.TL_messages_translateText req = new TLRPC.TL_messages_translateText();
+        req.flags |= 2;
+        TLRPC.TL_textWithEntities t = new TLRPC.TL_textWithEntities();
+        t.text = text;
+        req.text.add(t);
+        req.to_lang = toLang;
+        toast(f, uz.aloj.L.t("Tarjima qilinmoqda...", "Перевод..."));
+        ConnectionsManager.getInstance(f.getCurrentAccount()).sendRequest(req, (res, err) -> AndroidUtilities.runOnUIThread(() -> {
+            if (res instanceof TLRPC.TL_messages_translateResult && !((TLRPC.TL_messages_translateResult) res).result.isEmpty()) {
+                done.run(((TLRPC.TL_messages_translateResult) res).result.get(0).text);
+            } else {
+                toast(f, uz.aloj.L.t("Tarjima qilib bo'lmadi", "Не удалось перевести") + (err != null ? " (" + err.text + ")" : ""));
+            }
+        }));
+    }
