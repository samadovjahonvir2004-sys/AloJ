+    private static final Pattern BAD_LINK = Pattern.compile("(\\.apk\\b|bit\\.ly|cutt\\.ly|tinyurl|olx-[a-z]|olx\\.(?!uz)|click-uz|payme-[a-z]|uzcard-[a-z]|humo-[a-z])", Pattern.CASE_INSENSITIVE);
