+package uz.aloj;
+
+import org.telegram.messenger.LocaleController;
+
+/** AloJ: picks the AloJ text for the current app language (Russian UI → Russian, otherwise Uzbek). */
+public final class L {
+    private L() {}
+
+    public static boolean ru() {
+        try {
+            String lang = LocaleController.getInstance().getCurrentLocale().getLanguage();
+            return "ru".equals(lang) || "uk".equals(lang) || "be".equals(lang) || "kk".equals(lang);
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+
+    public static String t(String uz, String ru) {
+        return ru() ? ru : uz;
+    }
+}
