+    public static void setFav(long id, boolean fav) {
+        SharedPreferences p = prefs();
+        String all = p.getString("favs", "");
+        String key = "," + id + ",";
+        if (fav && !("," + all + ",").contains(key)) all = all.isEmpty() ? String.valueOf(id) : all + "," + id;
+        if (!fav) {
+            all = ("," + all + ",").replace(key, ",");
+            all = all.replaceAll("^,+|,+$", "");
+        }
+        p.edit().putBoolean("fav_" + id, fav).putString("favs", all).apply();
+    }
