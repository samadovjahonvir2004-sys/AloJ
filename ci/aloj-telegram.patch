+    }
+
+    public static void adminStatus(long id, String st) throws Exception {
+        json("POST", "/rest/v1/rpc/admin_set_status", new JSONObject().put("lid", id).put("st", st).toString(), true, null);
+    }
+
+    public static void adminDelete(long id) throws Exception {
+        json("POST", "/rest/v1/rpc/admin_delete", new JSONObject().put("lid", id).toString(), true, null);
+    }
+
+    public static void adminBannerSave(long id, String title, String sub, String img, String link, int sort) throws Exception {
+        JSONObject o = new JSONObject().put("bid", id).put("t", title).put("sub", sub).put("img", img == null ? "" : img).put("lnk", link == null ? "" : link).put("srt", sort);
+        json("POST", "/rest/v1/rpc/admin_banner_save", o.toString(), true, null);
+    }
+
+    public static void adminBannerDelete(long id) throws Exception {
+        json("POST", "/rest/v1/rpc/admin_banner_delete", new JSONObject().put("bid", id).toString(), true, null);
+    }
