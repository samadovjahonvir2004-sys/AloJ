+package org.telegram.ui;
+
+import android.app.Activity;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Color;
+import android.os.Bundle;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.telegram.messenger.AloJCrash;
+
+import java.io.File;
+import java.io.FileInputStream;
+
+/** AloJ: plain screen (no app theme) that shows the last crash and lets the user copy it. */
+public class AloJCrashActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        String text = "Xato ma'lumoti topilmadi.";
+        try {
+            File f = AloJCrash.file(this);
+            byte[] data = new byte[(int) f.length()];
+            FileInputStream in = new FileInputStream(f);
+            int n = in.read(data);
+            in.close();
+            if (n > 0) text = new String(data, 0, n, "UTF-8");
+        } catch (Throwable ignore) {
+        }
+        final String report = text;
+        int pad = (int) (16 * getResources().getDisplayMetrics().density);
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(Color.rgb(14, 16, 19));
+        root.setPadding(pad, pad * 2, pad, pad);
+
+        TextView title = new TextView(this);
+        title.setText("AloJ xatoga uchradi");
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(20);
+        root.addView(title);
+
+        TextView hint = new TextView(this);
+        hint.setText("\"Nusxa olish\" tugmasini bosing va matnni ishlab chiquvchiga yuboring.");
+        hint.setTextColor(Color.rgb(180, 184, 194));
+        hint.setPadding(0, pad / 2, 0, pad / 2);
+        root.addView(hint);
+
+        Button copy = new Button(this);
+        copy.setText("Nusxa olish");
+        copy.setOnClickListener(v -> {
+            ClipboardManager cm = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
+            cm.setPrimaryClip(ClipData.newPlainText("AloJ crash", report));
+            Toast.makeText(this, "Nusxa olindi", Toast.LENGTH_SHORT).show();
+        });
+        root.addView(copy);
+
+        Button share = new Button(this);
+        share.setText("Ulashish");
+        share.setOnClickListener(v -> {
+            Intent s = new Intent(Intent.ACTION_SEND);
+            s.setType("text/plain");
+            s.putExtra(Intent.EXTRA_TEXT, report);
+            startActivity(Intent.createChooser(s, "AloJ xato"));
+        });
+        root.addView(share);
+
+        ScrollView sv = new ScrollView(this);
+        TextView body = new TextView(this);
+        body.setText(report);
+        body.setTextIsSelectable(true);
+        body.setTextColor(Color.rgb(236, 237, 240));
+        body.setTextSize(11);
+        body.setTypeface(android.graphics.Typeface.MONOSPACE);
+        body.setPadding(0, pad, 0, pad);
+        sv.addView(body);
+        root.addView(sv, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        setContentView(root);
+    }
+}
